ANTHROPIC_API_KEY=your_key_here
DATABASE_URL=sqlite:///./data/erp_mock.db

# CORS: comma-separated origins
ALLOWED_ORIGINS=http://localhost:5173

# JWT settings
JWT_SECRET_KEY=replace_with_a_strong_random_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=semanticintelligence-api
JWT_AUDIENCE=semanticintelligence-clients

# Auth users (JSON array, no plaintext passwords).
# password_hash format: pbkdf2_sha256$iterations$salt$base64_hash
# Generate hash with:
# python scripts/generate_password_hash.py
# Example:
# AUTH_USERS_JSON=[{"username":"admin","password_hash":"pbkdf2_sha256$600000$change_me_salt$change_me_base64_hash","role":"admin","disabled":false},{"username":"analyst","password_hash":"pbkdf2_sha256$600000$change_me_salt2$change_me_base64_hash2","role":"user","disabled":false}]
AUTH_USERS_JSON=[]
