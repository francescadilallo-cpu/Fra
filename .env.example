# ── Backend ───────────────────────────────────────────────────────────────────

# Required: Anthropic API key for LLM query features
ANTHROPIC_API_KEY=sk-ant-api03-...

# Required: strong random secret for JWT signing (min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-use-a-strong-random-secret-at-least-32-chars

# Required: user accounts as a JSON array
# Each entry: {"username": "...", "password_hash": "<bcrypt>", "role": "admin|user"}
# Generate a bcrypt hash: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
AUTH_USERS_JSON=[{"username":"admin","password_hash":"$2b$12$REPLACE_WITH_REAL_HASH","role":"admin"},{"username":"user1","password_hash":"$2b$12$REPLACE_WITH_REAL_HASH","role":"user"}]

# Optional: comma-separated list of allowed CORS origins (default: http://localhost:5173)
ALLOWED_ORIGINS=http://localhost:5173

# Optional: JWT token expiry in minutes (default: 30)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: distributed cache for semantic ask endpoint
# Leave SEMANTIC_REDIS_URL empty to disable Redis cache.
SEMANTIC_REDIS_URL=
SEMANTIC_REDIS_TTL_SECONDS=120

# ── Frontend (Docker build-time) ──────────────────────────────────────────────

# Leave empty when running behind the nginx reverse proxy (default for Docker Compose)
# The nginx container proxies /api/ → backend:8000, so relative paths work automatically.
# Set to a full URL only when deploying the frontend standalone without nginx.
# Example for standalone: VITE_API_URL=https://api.example.com
VITE_API_URL=

# ── DuckDB storage mode ───────────────────────────────────────────────────────
# FRA_STORAGE_MODE controls local persistence behavior:
# - nostore  (default): no local datalake persistence, ephemeral in-memory DuckDB
# - snapshot: persistent local DuckDB snapshot file
FRA_STORAGE_MODE=nostore

# ── DuckDB live pushdown (optional — only needed for real production DBs) ─────
# When set, the backend connects directly to the source instead of using the
# standard scenario source files.

# ERP: PostgreSQL DSN  (triggers postgres_scanner)
# ERP_POSTGRES_DSN=postgresql://user:password@host:5432/erp_db

# CRM: SQLite file path (triggers sqlite_scanner)
# CRM_SQLITE_PATH=/data/crm.sqlite

# HR: CSV file path    (triggers streaming read_csv)
# HR_CSV_PATH=/data/hr_employees.csv

# PIM: JSON file path  (triggers streaming read_json)
# PIM_JSON_PATH=/data/products.json
